{
  "name": "hustcord-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch --builder swc",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "mocha --require ts-node/register --extensions ts --recursive 'test/**/*.spec.ts'",
    "test:watch": "mocha --require ts-node/register --extensions ts --recursive 'test/**/*.spec.ts' --watch --watch-extensions ts",
    "test:cov": "nyc mocha --require ts-node/register --extensions ts --recursive 'test/**/*.spec.ts'"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.18",
    "@nestjs/swagger": "^11.2.7",
    "@nestjs/websockets": "^11.1.18",
    "@supabase/supabase-js": "^2.106.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.1",
    "mongoose": "^9.4.1",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.40",
    "@types/bcryptjs": "^2.4.6",
    "@types/chai": "^4.3.11",
    "@types/express": "^5.0.0",
    "@types/mocha": "^10.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/sinon": "^17.0.2",
    "@types/socket.io": "^3.0.1",
    "chai": "^4.3.10",
    "chokidar": "^5.0.0",
    "class-validator": "^0.15.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "prettier": "^3.4.2",
    "sinon": "^17.0.1",
    "source-map-support": "^0.5.21",
    "swc-loader": "^0.2.7",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "mocha": {
    "require": "ts-node/register",
    "extensions": [
      "ts"
    ],
    "spec": "test/**/*.spec.ts",
    "timeout": 5000
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "exclude": [
      "**/*.spec.ts",
      "node_modules"
    ],
    "reporter": [
      "text",
      "html"
    ],
    "all": true
  }
}
